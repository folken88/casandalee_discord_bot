# Casandalee Discord Bot Configuration
# Copy this file to .env and update with your actual values

# Discord Bot Configuration (REQUIRED)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here
GUILD_ID=303941538021638164

# OpenAI Configuration (OPTIONAL - for LLM features)
OPENAI_API_KEY=your_openai_api_key_here

# FoundryVTT Configuration (OPTIONAL - for table integration)
FOUNDRY_URL=http://localhost:30000
FOUNDRY_USERNAME=your_foundry_username
FOUNDRY_PASSWORD=your_foundry_password


# Bot Configuration
BOT_NAME=Casandalee
BOT_PREFIX=/cass

# Campaign Configuration
CAMPAIGN_YEAR=4717
CAMPAIGN_MONTH=April

# Google Sheets Configuration (OPTIONAL - for real-time data)
GOOGLE_SHEETS_API_KEY=AIzaSyAzRvO3NFclV5PUTIbsKtyscw8sdP6Ck4c
GOOGLE_SHEETS_SPREADSHEET_ID=1u3p__ENz4ii6dRbrmRchj8OgR_3AN6EGJO9xnhVR63I
GOOGLE_SHEETS_TIMELINE_RANGE=Sheet1!A1:D800
GOOGLE_SHEETS_CHARACTERS_RANGE=Sheet1!A1:D800
GOOGLE_SHEETS_REFRESH_INTERVAL=86400000

# YouTube Transcript Processing (OPTIONAL)
# Comma-separated YouTube playlist IDs to monitor for D&D session recordings
YOUTUBE_PLAYLIST_IDS=PL0y2CS3X3x74xd18b9sEcuhiI5QWFkv9U,PL0y2CS3X3x777aFfVyhTg0eviGTAu-L52,PL0y2CS3X3x762i7XlRLRbHMacOszf6jsy,PL0y2CS3X3x75Nnv-XfVJqTGkApnQsozDx,PL0y2CS3X3x75wxU-qV6S9a_7WDbKG0eZI
# Discord channel ID where session summaries are posted
YOUTUBE_SUMMARY_CHANNEL_ID=
# How often to check for new videos (ms, default 24 hours)
# Sessions happen Thursdays 7-10pm Chicago time; checking once daily is plenty
YOUTUBE_CHECK_INTERVAL=86400000
# Characters per LLM chunk when processing transcripts (default 4000)
YOUTUBE_TRANSCRIPT_CHUNK_SIZE=4000
# Map playlist IDs to campaign AP codes: playlistId:CODE,playlistId:CODE
YOUTUBE_PLAYLIST_CAMPAIGNS=PL0y2CS3X3x74xd18b9sEcuhiI5QWFkv9U:SS,PL0y2CS3X3x777aFfVyhTg0eviGTAu-L52:IG,PL0y2CS3X3x762i7XlRLRbHMacOszf6jsy:CC,PL0y2CS3X3x75Nnv-XfVJqTGkApnQsozDx:HV,PL0y2CS3X3x75wxU-qV6S9a_7WDbKG0eZI:HR
# Player-to-character mapping: player:character:campaign (comma-separated)
YOUTUBE_PLAYER_MAP=kip:ulfred:IG,kip:holden:SS

# Obsidian Vault Path (OPTIONAL - defaults to obsidian_cass/cassvault)
# OBSIDIAN_VAULT_PATH=C:\Users\Tobias Merriman\Documents\cass_discord_bot\obsidian_cass\cassvault

# Node Environment
NODE_ENV=development

